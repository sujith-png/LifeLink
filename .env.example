PORT=3000
NODE_ENV=development
JWT_SECRET=lifelink_super_secret_jwt_key_2026_secure
DB_PATH=lifelink.db
MOCK_NOTIFICATIONS=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Administrator Credentials
ADMIN_EMAIL=admin@lifelink.org
ADMIN_PASSWORD=SetAStrongPasswordHere!123

# ==============================================================================
# FIREBASE PHONE AUTHENTICATION CONFIGURATION
# ==============================================================================
# Step 1: Create a project at https://console.firebase.google.com
# Step 2: Enable "Phone" under Authentication -> Sign-in method
# Step 3: Register a Web App in Project Settings -> General -> Your Apps
# Step 4: Paste your Web App credentials below:
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_firebase_app_id

# Backend Server Firebase Admin SDK Credentials:
# In Firebase Console -> Project Settings -> Service accounts -> Click "Generate new private key"
# Place the downloaded JSON file in your project root or set the relative path:
FIREBASE_SERVICE_ACCOUNT_KEY=./serviceAccountKey.json

# Alternatively, set individual service account credentials:
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgk...\n-----END PRIVATE KEY-----\n"

# ==============================================================================
# LEGACY / ALTERNATIVE SMS PROVIDERS (Optional Fallbacks)
# ==============================================================================
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
# FAST2SMS_API_KEY=
